# ==========================================
# AssetFlow ERP - Backend Environment Config
# ==========================================

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/assetflow?schema=public"

# Cryptographically Secure JWT Secret Key (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="your_production_jwt_secret_key_here"
JWT_REFRESH_SECRET="your_production_jwt_refresh_secret_key_here"

# Server Port
PORT=5000
NODE_ENV=production
